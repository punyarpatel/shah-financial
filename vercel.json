    },
    {
      "source": "/about/index.html",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/blog/index.html",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/disclosures/index.html",
      "destination": "/disclosures",
      "permanent": true
    },
    {
      "source": "/privacy-policy/index.html",
      "destination": "/privacy-policy",
      "permanent": true
    },
    {
      "source": "/terms-of-service/index.html",
      "destination": "/terms-of-service",
      "permanent": true
    },
    {
      "source": "/mutual-funds",
      "destination": "/services/mutual-funds",
      "permanent": true
    },
    {
      "source": "/insurance",
      "destination": "/services/insurance",
      "permanent": true
    },
    {
      "source": "/retirement",
      "destination": "/services/retirement",
      "permanent": true
    },
    {
      "source": "/goal-planning",
